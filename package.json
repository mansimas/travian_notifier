{
  "name": "travian_notifier",
  "private": true,
  "version": "1.0.0",
  "description": "Rings your phone (free Telegram call) when a Travian village gets an incoming attack",
  "main": "app.js",
  "scripts": {
    "start": "git pull origin main && npm install && pm2 startOrReload ecosystem.config.js && pm2 logs TravianNotifier",
    "restart": "pm2 reload TravianNotifier",
    "check": "node scripts/run.js check",
    "test-call": "node scripts/run.js test-call",
    "test-alarm": "node scripts/run.js test-alarm",
    "oases": "node scripts/run.js oases",
    "troops": "node scripts/run.js troops",
    "autoraid": "node scripts/run.js autoraid",
    "reports-backfill": "node scripts/run.js reports-backfill"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mansimas/travian_notifier.git"
  },
  "author": "mantas",
  "license": "",
  "dependencies": {
    "dotenv": "^16.3.1",
    "sails": "^1.5.8"
  }
}
