# Copy to .env (never committed) and fill in.
# Your game world, as in the browser address bar, e.g. ts30.x3.europe.travian.com
TRAVIAN_SERVER=
TRAVIAN_USERNAME=
TRAVIAN_PASSWORD=
# Your Telegram @username (Telegram > Settings > Username). CallMeBot calls it.
TELEGRAM_USER=@
# Optional
POLL_MINUTES=3
POLL_JITTER_MINUTES=2
CALL_LANG=en-GB-Standard-B
# Each call lasts at most 30 s (CallMeBot), so the alarm is CALL_COUNT calls CALL_GAP_SECONDS apart
CALL_COUNT=1
CALL_GAP_SECONDS=70
CALL_REPEAT=3
# After an alarm, no other alarm for this many hours (new attacks are only logged)
CALL_COOLDOWN_HOURS=10
# Times on the /mute page
TIMEZONE=Europe/Vilnius

# The village oasis stages are counted from (GET /oases, npm run oases)
OASIS_VILLAGE=mansim2

# Auto raids (AutoRaidService): AUTO_RAID=1 runs rounds, AUTO_RAID_SEND=0 makes them a dry run
AUTO_RAID=
AUTO_RAID_VILLAGE=mansim1
AUTO_RAID_WATCH=mansim1,mansim2
